{"metadata":{"mode":"resource-shard","collection_id":"col_1792394","resource_count":1,"edge_count":13,"authoritative_graph":"../arche_graph.json"},"elements":{"nodes":[{"data":{"id":"res_1803839","arche_id":"1803839","label":"jau_funddatenbank.zip","title":"jau_funddatenbank.zip","filename":"jau_funddatenbank.zip","type":"resource","type_label":"ARCHE-Datei","ftype":"other","parent_col":"col_1792394","parent_arche_id":"1792394","pid":"https://hdl.handle.net/21.11115/0000-0016-0D49-9","place":"Jaunstein","spatial_ids":["1756733"],"spatial_ids_direct":["1756733"],"spatial_ids_inherited":[],"spatial_relation_status":"asserted","spatial_inherited_from":null,"subjs":["Archäologie","Ausgrabungsstätten","Daten (Informationen)","Datenbanken","archäologische Objekte","archäologische Stätten","digital geboren"],"path":["IUENNA","IUENNA - openIng the soUthErn jauNtal as a micro-regioN for future Archaeology","Jaunstein-Collection (JAU)","03_05_Datenbanken"],"date":"2025-03-03","size_bytes":11350603,"formatted_size":"10.8 MB","thumb_url":"https://arche-thumbnails.acdh.oeaw.ac.at/?id=https%3A%2F%2Fhdl.handle.net%2F21.11115%2F0000-0016-0D49-9&width=360","coords":[14.67102,46.55936],"description":"Originäre MS Access-Datenbank zu den während der Ausgrabungen am Fundplatz Jaunstein (JAU) getätigten Funden. Es handelt sich um eine strukturierte archäologische Datenbank,die Funde und assoziierte Literatur dokumentiert. Die Kerntabellen umfassen Fundstücke,die zentrale Informationen wie Fundname,Jahr,Typologie,Erhaltungszustand,Datierung,Dekor und Materialfarbe erfassen,um eine präzise Klassifikation zu ermöglichen. Zudem werden zusätzliche Tabellen wie Literatur und Autor verwendet,um wissenschaftliche Arbeiten und ihre Autoren mit einzelnen Funden zu verknüpfen. Die Datenbank unterstützt eine Analyse der materiellen Kultur,was für eine weiterführende wissenschaftliche Bearbeitung und Veröffentlichung essentiell ist​. Die Tabellen liegen als 173 CSV-Dateien vor,ein ER-Diagramm wie auch eine detaillierte deskriptive Dokumentation der Datenbank ist vorhanden.","color":"#3D7068","icon":"fa-file","uri":"https://arche.acdh.oeaw.ac.at/api/1803839","roles":["resource"]},"position":{"x":-757.9,"y":861.4}}],"edges":[{"data":{"id":"edge_isPartOf_res_1803839_col_1792394","source":"res_1803839","target":"col_1792394","label":"isPartOf","provenance":"ARCHE-corpus","provenance_sources":["ARCHE-corpus","ARCHE-direct"],"relation_status":"asserted"}},{"data":{"id":"edge_hasSpatialCoverage_res_1803839_plc_1756733","source":"res_1803839","target":"plc_1756733","label":"hasSpatialCoverage","provenance":"ARCHE-corpus","provenance_sources":["ARCHE-corpus","ARCHE-direct"],"relation_status":"asserted"}},{"data":{"id":"edge_documents_res_1803839_pub_1756764","source":"res_1803839","target":"pub_1756764","label":"documents","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_documents_res_1803839_pub_1756912","source":"res_1803839","target":"pub_1756912","label":"documents","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasCreator_res_1803839_org_37483","source":"res_1803839","target":"org_37483","label":"hasCreator","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasCurator_res_1803839_per_66763","source":"res_1803839","target":"per_66763","label":"hasCurator","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasDepositor_res_1803839_per_1756725","source":"res_1803839","target":"per_1756725","label":"hasDepositor","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasHosting_res_1803839_org_3313","source":"res_1803839","target":"org_3313","label":"hasHosting","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasLicensor_res_1803839_org_37483","source":"res_1803839","target":"org_37483","label":"hasLicensor","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasMetadata