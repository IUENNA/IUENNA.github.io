{"metadata":{"mode":"resource-shard","collection_id":"col_1792273","resource_count":2,"edge_count":25,"authoritative_graph":"../arche_graph.json"},"elements":{"nodes":[{"data":{"id":"res_1798918","arche_id":"1798918","label":"hb20_funde.zip","title":"hb20_funde.zip","filename":"hb20_funde.zip","type":"resource","type_label":"ARCHE-Datei","ftype":"other","parent_col":"col_1792273","parent_arche_id":"1792273","pid":"https://hdl.handle.net/21.11115/0000-0015-F9AF-C","place":"Hemmaberg","spatial_ids":["1756734"],"spatial_ids_direct":["1756734"],"spatial_ids_inherited":[],"spatial_relation_status":"asserted","spatial_inherited_from":null,"subjs":["Archäologie","Ausgrabungsstätten","Daten (Informationen)","Datenbanken","archäologische Objekte","archäologische Stätten","digital geboren","virtuelle Modelle"],"path":["IUENNA","IUENNA - openIng the soUthErn jauNtal as a micro-regioN for future Archaeology","Hemmaberg-Collection (HB)","02_05_Datenbanken"],"date":"2025-03-03","size_bytes":12152419,"formatted_size":"11.6 MB","thumb_url":"https://arche-thumbnails.acdh.oeaw.ac.at/?id=https%3A%2F%2Fhdl.handle.net%2F21.11115%2F0000-0015-F9AF-C&width=360","coords":[14.66768,46.55269],"description":"Originäre MS Access-Datenbank mit Funden vom Hemmaberg aus dem Jahr 2020. Die Datenbank dokumentiert archäologische Fundstücke und assoziierte Literatur. Sie umfasst zentrale Tabellen,darunter Fundstücke,die Informationen wie Fundname,ObjektNr,Typologie,Erhaltungszustand,Datierung und Oberflächeneigenschaften eines Objekts abbilden. Zusätzliche Tabellen wie Literatur,Autor,und Koautor ordnen jedem Fund die entsprechende wissenschaftliche Dokumentation und Autoreninformationen zu. Diese Struktur ermöglicht Klassifikationen der Funde und ihrer Merkmale,etwa durch Angaben zur Farbe,Dekor,Lage,sowie der Beschaffenheit. Die Datenbank unterstützt eine Analyse der materiellen Kultur,was für eine weiterführende wissenschaftliche Bearbeitung und Veröffentlichung essentiell ist​. Die Tabellen liegen als 197 CSV-Dateien vor,ein ER-Diagramm wie auch eine detaillierte deskriptive Dokumentation der Datenbank ist vorhanden.","color":"#3D7068","icon":"fa-file","uri":"https://arche.acdh.oeaw.ac.at/api/1798918","roles":["resource"]},"position":{"x":147.8,"y":-614.2}},{"data":{"id":"res_1798919","arche_id":"1798919","label":"hb_bioarchaeologie_samples.zip","title":"hb_bioarchaeologie_samples.zip","filename":"hb_bioarchaeologie_samples.zip","type":"resource","type_label":"ARCHE-Datei","ftype":"other","parent_col":"col_1792273","parent_arche_id":"1792273","pid":"https://hdl.handle.net/21.11115/0000-0015-F9B0-9","place":"Hemmaberg","spatial_ids":["1756734"],"spatial_ids_direct":["1756734"],"spatial_ids_inherited":[],"spatial_relation_status":"asserted","spatial_inherited_from":null,"subjs":["Archäologie","Ausgrabungsstätten","Daten (Informationen)","Datenbanken","archäologische Objekte","archäologische Stätten","digital geboren","virtuelle Modelle"],"path":["IUENNA","IUENNA - openIng the soUthErn jauNtal as a micro-regioN for future Archaeology","Hemmaberg-Collection (HB)","02_05_Datenbanken"],"date":"2025-03-03","size_bytes":26009295,"formatted_size":"24.8 MB","thumb_url":"https://arche-thumbnails.acdh.oeaw.ac.at/?id=https%3A%2F%2Fhdl.handle.net%2F21.11115%2F0000-0015-F9B0-9&width=360","coords":[14.66768,46.55269],"description":"Originäre MS Access-Datenbank mit Proben zur Bioarchäologie vom Hemmaberg. Die bioarchäologische Datenbank strukturiert detaillierte Informationen antiker Individuen,einschließlich deren Geschlechts- und Altersbestimmung,pathologischer Veränderungen,sowie Knochen- und Zahnmerkmale. Das Modell enthält zentrale Entitäten wie das Individuum selbst,mit Basisdaten zu Fundort,Geschlecht,Körperhöhe und Alter,sowie spezialisierte Felder zur Analyse nicht-metrischer Merkmale,Gelenk- und Knochenzuständen,die krankhafte Veränderungen dokumentieren. Weiterhin erfasst es spezielle Anmerkungen und Bildmaterialien,um Besonderheiten zu dokumentieren. Diese Struktur dient als Grundlage zur Analyse physischer und sozialer Aspekte antiker Populationen und bietet Einblicke in Gesundheit,Lebensweise und Verwandtschaftsverhältnisse. Die Tabellen liegen als 442 CSV-Dateien vor,ein ER-Diagramm wie auch eine detaillierte deskriptive Dokumentation der Datenbank ist vorhanden.","color":"#3D7068","icon":"fa-file","uri":"https://arche.acdh.oeaw.ac.at/api/1798919","roles":["resource"]},"position":{"x":58.4,"y":-577.2}}],"edges":[{"data":{"id":"edge_isPartOf_res_1798918_col_1792273","source":"res_1798918","target":"col_1792273","label":"isPartOf","provenance":"ARCHE-corpus","provenance_sources":["ARCHE-corpus","ARCHE-direct"],"relation_status":"asserted"}},{"data":{"id":"edge_hasSpatialCoverage_res_1798918_plc_1756734","source":"res_1798918","target":"plc_1756734","label":"hasSpatialCoverage","provenance":"ARCHE-corpus","provenance_sources":["ARCHE-corpus","ARCHE-direct"],"relation_status":"asserted"}},{"data":{"id":"edge_isPartOf_res_1798919_col_1792273","source":"res_1798919","target":"col_1792273","label":"isPartOf","provenance":"ARCHE-corpus","provenance_sources":["ARCHE-corpus","ARCHE-direct"],"relation_status":"asserted"}},{"data":{"id":"edge_hasSpatialCoverage_res_1798919_plc_1756734","source":"res_1798919","target":"plc_1756734","label":"hasSpatialCoverage","provenance":"ARCHE-corpus","provenance_sources":["ARCHE-corpus","ARCHE-direct"],"relation_status":"asserted"}},{"data":{"id":"edge_documents_res_1798918_pub_1756764","source":"res_1798918","target":"pub_1756764","label":"documents","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasCreator_res_1798918_org_37483","source":"res_1798918","target":"org_37483","label":"hasCreator","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasCurator_res_1798918_per_66763","source":"res_1798918","target":"per_66763","label":"hasCurator","provenance":"ARCHE-direct","relation_status":"asserted"}},{"data":{"id":"edge_hasDepositor_res_